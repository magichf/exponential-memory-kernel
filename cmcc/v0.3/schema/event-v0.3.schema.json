{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmcc.invalid/schema/event-v0.3.schema.json",
  "title": "CMCC v0.3 Immutable Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "message_id",
    "conversation_id",
    "channel_id",
    "event_type",
    "actor",
    "timestamp",
    "nonce",
    "expires_at",
    "payload",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "event_id": {
      "type": "string",
      "pattern": "^(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "channel_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_type": {
      "enum": [
        "created",
        "read_receipt",
        "delivered",
        "replied",
        "acked",
        "expired",
        "closed"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "auth_mode"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "auth_mode": {
          "enum": [
            "self_declared",
            "signed",
            "trusted_agent"
          ]
        },
        "key_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonce": {
      "type": "string",
      "minLength": 22,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "in_reply_to",
        "subject_event_id",
        "content_hash"
      ],
      "properties": {
        "content": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_reply_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"
        }
      }
    },
    "signature": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "Ed25519"
          ]
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "created",
              "replied"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "created"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "in_reply_to": {
                "type": "null"
              },
              "subject_event_id": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "replied"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "in_reply_to": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "read_receipt",
              "delivered",
              "acked",
              "expired",
              "closed"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "subject_event_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "auth_mode": {
                "const": "signed"
              }
            },
            "required": [
              "auth_mode"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "signature": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "auth_mode": {
                "enum": [
                  "self_declared",
                  "trusted_agent"
                ]
              }
            },
            "required": [
              "auth_mode"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "signature": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  ]
}
